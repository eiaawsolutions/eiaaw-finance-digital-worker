# =============================================================================
# EIAAW Finance Digital Worker — environment contract
# =============================================================================
#
# EIAAW DEPLOY CONTRACT (non-negotiable):
#
#   The ONLY raw secret values that ever live in this file, in Railway env, or
#   in any deployment target's config are the three Infisical machine-identity
#   bootstrap credentials below.
#
#   EVERY other secret — Anthropic, OpenAI, SMTP, Telegram, WhatsApp BSP, R2,
#   KMS, log-integrity keys, connector credentials, JWT signing keys — lives in
#   Infisical and is referenced here by a `secret://project/env/NAME` handle.
#   The resolver (packages/core/src/secrets) dereferences handles at boot; the
#   raw value never enters a config export, a log line, or a prompt.
#
#   EIAAW house convention: one shared workspace (`eiaaw-all-projects`), one
#   environment per stage, every secret FLAT AT THE ROOT. A handle may still
#   carry a folder path (`secret://project/env/folder/NAME`) if a project ever
#   needs segregated custody, but flat is the default everywhere.
#
#   If you are about to paste an `sk-ant-...`, `sk_live_...`, or any other live
#   credential into this file, stop. Put it in Infisical and reference it here.
#
# DWD-06 s.13 (fail-closed): a required setting that is absent causes a refusal,
# never a default. That applies to this file too — the boot sequence refuses to
# start rather than substituting a value.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Infisical bootstrap — the only raw credentials permitted anywhere
# -----------------------------------------------------------------------------
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SITE_URL=https://app.infisical.com
# Set false ONLY for local development against a .env.local with dev-only stubs.
INFISICAL_RESOLVER_ENABLED=true


# -----------------------------------------------------------------------------
# 2. Runtime identity
# -----------------------------------------------------------------------------
NODE_ENV=development
# One of: dev | test | staging | prod  (DWD-06 s.14.3)
# Dry-run is forced ON for every state-changing tool in dev, test and staging.
# That is enforced by the runtime, not by configuration a developer can flip.
DEPLOY_ENVIRONMENT=dev
PLATFORM_VERSION=0.1.0
# Residency zone stamped on every context and every store (DWD-06 s.10.6).
# A cross-zone read or write refuses with HTTP 451.
RESIDENCY_ZONE=my-central

API_PORT=3000
API_HOST=0.0.0.0
CONSOLE_PORT=3001
PUBLIC_API_URL=http://localhost:3000
PUBLIC_CONSOLE_URL=http://localhost:3001


# -----------------------------------------------------------------------------
# 3. Data stores
# -----------------------------------------------------------------------------
# Railway injects DATABASE_URL for the attached Postgres service. Locally this
# is a plain connection string; in prod it is provided by Railway itself and is
# the one exception to the handle rule, because Railway owns the credential.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eiaaw_fdw
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis backs the read-through configuration cache and channel back-pressure.
# The cache is never a source of truth (DWD-06 s.10.1).
REDIS_URL=redis://localhost:6379

# Object store for raw bodies, attachments, rendered outputs, audit payloads.
# driver: local | s3   (S3 driver targets Cloudflare R2 in EIAAW deployments)
OBJECT_STORE_DRIVER=local
OBJECT_STORE_LOCAL_PATH=./.local-object-store
OBJECT_STORE_BUCKET=eiaaw-fdw-artifacts
OBJECT_STORE_ENDPOINT=secret://eiaaw-all-projects/dev/R2_ENDPOINT
OBJECT_STORE_ACCESS_KEY_ID=secret://eiaaw-all-projects/dev/R2_ACCESS_KEY_ID
OBJECT_STORE_SECRET_ACCESS_KEY=secret://eiaaw-all-projects/dev/R2_SECRET_ACCESS_KEY

# WORM audit store. DWD-06 s.3.14 / file 07 s.9: the audit log is one of the two
# undeferrable components. `postgres` uses an append-only table with a per-tenant
# hash chain and REVOKEd UPDATE/DELETE; `s3-object-lock` adds the second
# destination outside the worker's write control (Phase 0 acceptance P0-3).
WORM_DRIVER=postgres
WORM_SECONDARY_DRIVER=none
WORM_SECONDARY_BUCKET=eiaaw-fdw-worm
WORM_ANCHOR_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
# 4. Cryptography — every value is an Infisical handle
# -----------------------------------------------------------------------------
# Signs the audit hash chain's periodic anchor. Rotating it does not invalidate
# earlier anchors; verification walks the chain per key epoch.
AUDIT_CHAIN_ANCHOR_KEY=secret://eiaaw-all-projects/dev/AUDIT_CHAIN_ANCHOR_KEY
# Envelope key for tenant-scoped field encryption.
KMS_MASTER_KEY=secret://eiaaw-all-projects/dev/KMS_MASTER_KEY
# Signs approval nonces and hand-off callback tokens (DWD-06 s.6.5).
NONCE_SIGNING_KEY=secret://eiaaw-all-projects/dev/NONCE_SIGNING_KEY
# Session/JWT signing for the console.
SESSION_SIGNING_KEY=secret://eiaaw-all-projects/dev/SESSION_SIGNING_KEY

# The canary is a synthetic secret planted in the vault. Phase 0 acceptance P0-7
# requires it never to appear in a prompt, a log line, or a model response.
SECRET_CANARY=secret://eiaaw-all-projects/dev/SECRET_CANARY


# -----------------------------------------------------------------------------
# 5. Identity provider (principals) — OIDC
# -----------------------------------------------------------------------------
OIDC_ISSUER=secret://eiaaw-all-projects/dev/OIDC_ISSUER
OIDC_CLIENT_ID=secret://eiaaw-all-projects/dev/OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=secret://eiaaw-all-projects/dev/OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback


# -----------------------------------------------------------------------------
# 6. LLM gateway (C9)
# -----------------------------------------------------------------------------
# DWD-06 s.11.1: model and provider identities are ALWAYS client-entered, per
# tenant, at AS-SYS-*. These are the platform's *credential* handles only — the
# route (which model, which fallback, which ceiling) is tenant configuration,
# never an environment variable.
ANTHROPIC_API_KEY=secret://eiaaw-all-projects/dev/ANTHROPIC_API_KEY
OPENAI_API_KEY=secret://eiaaw-all-projects/dev/OPENAI_API_KEY
# Hard platform ceiling. A tenant budget at AS-SYS-BGT-* may be lower, never higher.
LLM_GLOBAL_COST_CEILING_MINOR=500000
LLM_GLOBAL_COST_CURRENCY=MYR

# Retrieval embeddings. `none` selects the deterministic dev provider, which
# gives identical vectors across runs so a retrieval test asserts retrieval
# logic rather than embedding drift. `prod` refuses to boot on it.
#
# EMBEDDING_DIMENSIONS must equal the width of knowledge_embeddings.embedding
# (1024 since migration 0010). Changing the model or the width means re-embedding
# the whole corpus, so they move together.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=secret://eiaaw-all-projects/dev/VOYAGE_API_KEY


# -----------------------------------------------------------------------------
# 7. Channel adapters (C1) — credentials only; behaviour lives at AS-SYS-*
# -----------------------------------------------------------------------------
# Email
EMAIL_INBOUND_WEBHOOK_SECRET=secret://eiaaw-all-projects/dev/EMAIL_INBOUND_WEBHOOK_SECRET
EMAIL_INBOUND_WEBHOOK_SECRET_NEXT=secret://eiaaw-all-projects/dev/EMAIL_INBOUND_WEBHOOK_SECRET_NEXT
EMAIL_SEND_API_KEY=secret://eiaaw-all-projects/dev/EMAIL_SEND_API_KEY
EMAIL_FROM_ADDRESS=finance.expert@example.test

# Telegram — the bot token is never the webhook secret (DWD-06 s.6.2)
TELEGRAM_BOT_TOKEN=secret://eiaaw-all-projects/dev/TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET_TOKEN=secret://eiaaw-all-projects/dev/TELEGRAM_WEBHOOK_SECRET_TOKEN
TELEGRAM_WEBHOOK_SECRET_TOKEN_NEXT=secret://eiaaw-all-projects/dev/TELEGRAM_WEBHOOK_SECRET_TOKEN_NEXT

# WhatsApp — talks to a BSP *port*, never a named BSP (DWD-06 s.4.4).
# driver: stub | cloud-api   Swapping BSP replaces one port implementation.
WHATSAPP_BSP_DRIVER=stub
WHATSAPP_APP_SECRET=secret://eiaaw-all-projects/dev/WHATSAPP_APP_SECRET
WHATSAPP_ACCESS_TOKEN=secret://eiaaw-all-projects/dev/WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=secret://eiaaw-all-projects/dev/WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=secret://eiaaw-all-projects/dev/WHATSAPP_VERIFY_TOKEN

# Common to all webhook verification (DWD-06 s.6.1 W3)
WEBHOOK_REPLAY_WINDOW_SECONDS=300


# -----------------------------------------------------------------------------
# 8. Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=eiaaw-finance-digital-worker
OTEL_TRACES_SAMPLER=parentbased_always_on
LOG_LEVEL=info
# Fails a span that is missing any required attribute (DWD-06 s.12.3).
# On in dev and test so the defect surfaces at authoring time.
OBSERVABILITY_CONFORMANCE_STRICT=true


# -----------------------------------------------------------------------------
# 9. Workflow executor (C7)
# -----------------------------------------------------------------------------
WORKFLOW_WORKER_CONCURRENCY=8
WORKFLOW_POLL_INTERVAL_MS=500
WORKFLOW_LEASE_SECONDS=60
WORKFLOW_MAX_ACTIVITY_ATTEMPTS=5
# Sweeps expired leases and fires timer-based transitions (SLA breach, context TTL).
WORKFLOW_SWEEPER_INTERVAL_MS=5000


# -----------------------------------------------------------------------------
# 10. Assurance harness (C13) — the second undeferrable component
# -----------------------------------------------------------------------------
ASSURANCE_SUITES_PATH=./packages/assurance/suites
ASSURANCE_RUN_OUTPUT_PATH=./assurance-runs
# The release gate is blocking, never advisory (DWD-06 s.14, red flags).
ASSURANCE_RELEASE_GATE_BLOCKING=true
