{
  "name": "@eiaaw/assurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "harness": "tsx --tsconfig ../../tsconfig.dev.json src/harness-cli.ts",
    "release-gate": "tsx --tsconfig ../../tsconfig.dev.json src/harness-cli.ts --gate",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@eiaaw/contracts": "workspace:*",
    "@eiaaw/core": "workspace:*",
    "@eiaaw/llm": "workspace:*",
    "@eiaaw/policy": "workspace:*",
    "@eiaaw/registry": "workspace:*",
    "@eiaaw/telemetry": "workspace:*"
  }
}
